cabal-version:      3.0
name:               deep-learning-in-haskell
version:            0.1.0.0
synopsis:           Deep Learning in Haskell
-- description:
license:            MIT
license-file:       LICENSE
author:             Gabriel Emannuel
maintainer:         gabriel.emannuel.gama.andrade@gmail.com
-- copyright:
category:           Math
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  MyLib
    other-modules: 
        Types, 
        Perceptron, 
        ActivationFunctions,
        Utils
    -- other-extensions:
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   src
    default-language: Haskell2010

executable deep-learning-in-haskell
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.20.2.0,
        deep-learning-in-haskell

    hs-source-dirs:   app
    default-language: Haskell2010

test-suite deep-learning-in-haskell-test
    import:           warnings
    default-language: Haskell2010
    other-modules: PerceptronTests
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.2.0,
        deep-learning-in-haskell,
        HUnit
